<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
  <!-- Fondo circular azul con gradiente -->
  <circle cx="16" cy="16" r="15" fill="url(#shieldGradient)" stroke="#0066cc" stroke-width="1"/>
  
  <!-- Definición del gradiente -->
  <defs>
    <radialGradient id="shieldGradient" cx="16" cy="16" r="15" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#66ccff" />
      <stop offset="100%" stop-color="#0066cc" />
    </radialGradient>
  </defs>
  
  <!-- Forma de escudo -->
  <path d="M16,5 L8,8 L8,16 C8,20 10,24 16,27 C22,24 24,20 24,16 L24,8 L16,5 Z" 
        fill="none" stroke="white" stroke-width="1.5" />
  
  <!-- Destellos de energía -->
  <path d="M16,9 L14,14 L10,14 L13,17 L12,21 L16,19 L20,21 L19,17 L22,14 L18,14 Z" 
        fill="white" opacity="0.8" />
  
  <!-- Borde brillante -->
  <circle cx="16" cy="16" r="15" fill="none" stroke="#99ddff" stroke-width="0.5" opacity="0.6" />
  
  <!-- Animación de pulso (simulada en SVG estático) -->
  <circle cx="16" cy="16" r="12" fill="none" stroke="#ffffff" stroke-width="0.5" opacity="0.3" />
</svg>